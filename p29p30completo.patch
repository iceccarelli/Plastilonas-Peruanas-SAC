+      ['envío', envio],
+      ['flujo', flujo],
+    ] as const;
+    for (const [nombre, src] of fuentes) {
+      expect(
+        sinComentarios(src),
+        `${nombre} vuelve a leer INDEXNOW_KEY del entorno`,
