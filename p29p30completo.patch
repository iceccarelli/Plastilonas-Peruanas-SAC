+  const flujo = readFileSync(join(ROOT, '.github/workflows/seo-maintenance.yml'), 'utf8');
+  const envio = readFileSync(join(ROOT, 'scripts/submit-indexnow.mjs'), 'utf8');
+
+  it('la clave está en el repositorio y es válida', () => {
