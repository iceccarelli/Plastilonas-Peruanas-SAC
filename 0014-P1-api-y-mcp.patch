+                    telefono: { type: 'string' },
+                    nombre: { type: 'string' },
+                    empresa: { type: 'string' },
+                    ruc: { type: 'string', pattern: '^\\d{11}$' },
+                    producto: { type: 'string' },
+                    cantidad: { type: 'string' },
+                    medidas: { type: 'string' },
+                    material: { type: 'string' },
+                    sector: { type: 'string' },
+                    aplicacion: { type: 'string' },
+                    ciudad_entrega: { type: 'string' },
+                    pais_entrega: { type: 'string' },
