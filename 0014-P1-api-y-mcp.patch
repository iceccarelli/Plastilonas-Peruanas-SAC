@@ -0,0 +1,46 @@
+# Fly.io — API pública y servidor MCP de Plastilonas Peruanas SAC.
+#
+# Región gru (São Paulo): es la más cercana a Lima con presencia de Fly, y quien
+# consulta esta API es un comprador en el Perú o un agente que responde por él.
+# La latencia de un cálculo no la nota nadie; la de una cadena de llamadas de un
+# agente, sí.
+
+app = "plastilonas-api"
+primary_region = "gru"
+
+[build]
+  dockerfile = "Dockerfile"
+
+[env]
+  PORT = "8080"
+  # El origen canónico del sitio del que esta API lee su verdad.
+  SITIO_URL = "https://plastilonas-peruanas-sac.vercel.app"
+  # El origen público de esta API. Cámbielo el día que tenga dominio propio:
+  # se publica en OpenAPI, en el descriptor MCP y en la consola.
+  ORIGEN_API = "https://plastilonas-api.fly.dev"
+
+[http_service]
+  internal_port = 8080
+  force_https = true
+  # Escala a cero cuando nadie pregunta. El arranque en frío de un proceso Node
+  # sin dependencias está por debajo del segundo, y una API de consulta tiene
+  # tráfico a ráfagas: no se paga por estar esperando.
+  auto_stop_machines = "stop"
+  auto_start_machines = true
+  min_machines_running = 0
+
+  [http_service.concurrency]
+    type = "requests"
+    soft_limit = 200
+    hard_limit = 250
+
+  [[http_service.checks]]
+    grace_period = "5s"
+    interval = "30s"
+    method = "GET"
+    timeout = "5s"
+    path = "/v1/salud"
+
+[[vm]]
+  size = "shared-cpu-1x"
+  memory = "256mb"
