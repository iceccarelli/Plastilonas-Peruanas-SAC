+
+/* CONTROLES DE FORMULARIO. Faltaban en la lista de arriba, y la capa de tinta
+   (mas abajo) SI los alcanzaba: un <input class="bg-white text-gray-900"> en
+   modo oscuro quedaba con fondo BLANCO y tinta CLARA -> 1.16:1, es decir texto
+   invisible. Pasaba en las cinco calculadoras y en el ordenador de /productos,
+   que son paginas donde alguien decide una compra.
+
+   Lo encontro una auditoria con axe-core sobre el DOM hidratado, no una
+   revision a ojo: en claro se ve perfecto y el defecto solo existe en oscuro.
+   Se arregla en la capa y no en cada componente para que tambien cubra el
+   formulario que alguien escriba manana. */
+.dark main :is(input, select, textarea).bg-white,
+.dark main :is(input, select, textarea):not([class*="bg-"]) {
+  background-color: var(--surface-raised);
+  color: var(--text);
+}
+.dark main :is(input, select, textarea):is(.border-gray-200, .border-gray-300) {
+  border-color: var(--border);
+}
+.dark main :is(input, textarea)::placeholder {
+  color: var(--text-muted);
+}
 .dark main :is(div, section, article, aside, li, p, span, dl, dd, dt, table, thead, tbody, tr, th, td, nav, ul, ol, figure, label).bg-gray-50,
 .dark main :is(div, section, article, aside, li, p, span, dl, dd, dt, table, thead, tbody, tr, th, td, nav, ul, ol, figure, label).bg-gray-100 {
   background-color: var(--surface-muted);
@@ -267,6 +289,12 @@ a:hover, button:hover {
 
 /* Tinta */
 .dark main .text-\[\#0A2540\] { color: var(--text) !important; }
+/* Los otros literales de tinta oscura que se colaron en el codigo. #334155 y
+   #64748B son slate-700/500 escritos a mano: sobre --surface-muted dan 1.64:1,
+   es decir texto casi invisible. Se remapean igual que #0A2540. #B45309 es el
+   ambar de aviso, que tambien nace pensado para fondo claro. */
+.dark main :is(.text-\[\#334155\], .text-\[\#64748B\]) { color: var(--text-muted) !important; }
+.dark main .text-\[\#B45309\] { color: #FCD34D !important; }
 /* gray-800 es tinta principal, no secundaria: mapearla a --text-muted dejaba
    el bloque "En resumen" de cada guia casi ilegible sobre fondo oscuro. */
 .dark main :is(.text-gray-800, .text-gray-900) { color: var(--text) !important; }
@@ -783,3 +811,97 @@ main h1, main h2, main h3 { letter-spacing: -0.02em; }
     outline: none;
   }
 }
+
+
+/* ── BLOQUE DE RESPUESTA DIRECTA ────────────────────────────────────────
+   Es el parrafo mas importante del sitio: el que los motores de respuesta
+   citan y el primero que lee una persona en las cunas, en /fabricar-o-importar
+   y en el hub de compra en ingles.
+
+   En oscuro era ILEGIBLE (2.33:1). El motivo es sutil y vale escribirlo: la
+   utilidad lleva modificador de opacidad —bg-emerald-50/60— y la capa de
+   arriba selecciona `.bg-emerald-50`, que es OTRA clase. El verde translucido
+   se mezclaba con la superficie oscura hasta dar un gris sucio, y encima
+   quedaba la tinta clara del tema.
+
+   Se corrige por nombre semantico, que ademas es a prueba de futuro: cualquier
+   pagina que use .respuesta-directa hereda el tratamiento correcto. */
+.dark .respuesta-directa {
+  background-color: color-mix(in srgb, var(--brand) 12%, var(--surface-raised));
+  border-color: color-mix(in srgb, var(--brand) 35%, var(--surface-raised));
+  color: var(--text) !important;
+}
+
+/* ── ENLACES Y ROTULOS VERDES EN OSCURO ─────────────────────────────────
+   #047857 (emerald-700) sobre las superficies oscuras da 2.59:1 - 3.04:1. Es
+   el color de casi todos los enlaces de accion del sitio. En oscuro se sube a
+   --brand-hover (#34D399), que sobre --surface-raised pasa de 7:1.
+   La regla de linea 296 ya lo hacia para .text-emerald-700; faltaba el literal
+   hexadecimal, que es como esta escrito en el 90% de los componentes. */
+.dark main .text-\[\#047857\],
+.dark main .text-\[\#059669\] {
+  color: var(--brand-hover) !important;
+}
+
+/* Y FUERA de <main>: la cabecera, el pie y la barra movil de contacto viven
+   sobre --surface-nav (#1C2C46), donde #047857 da 2.56:1. Son los enlaces de
+   accion que aparecen en las 230 paginas, incluido «WhatsApp» de la barra
+   inferior, que es el boton mas pulsado del sitio en un telefono.
+   En modo oscuro NINGUNA superficie es clara, asi que subir este verde no
+   puede romper ningun contraste al reves. */
+.dark :is(header, footer, nav) :is(.text-\[\#047857\], .text-\[\#059669\]) {
+  color: var(--brand-hover) !important;
+}
+
+
+/* ── TINTES TRANSLUCIDOS EN MODO OSCURO ────────────────────────────────
+   LA MISMA TRAMPA, TRES VECES. La capa de arriba remapea `.bg-emerald-50`,
+   pero Tailwind genera OTRA clase cuando se le pone modificador de opacidad:
+   `bg-emerald-50/60`. El selector no la alcanza, el verde palido translucido
+   se mezcla con la superficie oscura hasta dar un gris sucio (#7c888b) y
+   encima queda la tinta clara del tema: 3.1:1.
+
+   Afectaba a los bloques «Que hacemos / Que no afirmamos» de las tres cunas y
+   sus gemelas inglesas, al «Cuando NO nos compre» de /fabricar-o-importar y a
+   los avisos ambar de los hubs de industria. Es decir, precisamente los
+   bloques de honestidad, que son los que mas se leen y se citan.
+
+   Se usa selector de atributo porque es lo unico que ve el modificador, y se
+   cubren de una vez todas las opacidades presentes y futuras. */
+.dark main [class*="bg-emerald-50/"],
+.dark main [class*="bg-emerald-100/"],
+.dark main [class*="bg-green-50/"] {
+  background-color: color-mix(in srgb, var(--brand) 10%, var(--surface-raised)) !important;
+}
+.dark main [class*="bg-amber-50/"],
+.dark main [class*="bg-yellow-50/"] {
+  background-color: color-mix(in srgb, #f59e0b 12%, var(--surface-raised)) !important;
+}
+.dark main [class*="bg-red-50/"] {
+  background-color: color-mix(in srgb, #ef4444 12%, var(--surface-raised)) !important;
+}
+.dark main [class*="bg-blue-50/"],
+.dark main [class*="bg-sky-50/"] {
+  background-color: color-mix(in srgb, #3b82f6 12%, var(--surface-raised)) !important;
+}
+.dark main [class*="bg-gray-50/"],
+.dark main [class*="bg-gray-100/"],
+.dark main [class*="bg-slate-50/"] {
+  background-color: var(--surface-muted) !important;
+}
+
+/* OJO CON LOS VARIANTES. La primera version de esta regla cubria tambien el
+   blanco translucido, y un selector de atributo no distingue la utilidad de su
+   variante: casaba igual con la version `hover:`. El resultado fue que el boton
+   blanco del CTA final —el mas pulsado del sitio— se pintaba oscuro con tinta
+   #0A2540 encima: 1.09:1. Lo detecto la propia auditoria en la pasada
+   siguiente, no una lectura. El blanco se quedo fuera de la regla en lugar de
+   afinarse: menos superficie, menos sorpresas. La prueba de
+   test/regresiones-ui.test.ts impide que vuelva. */
+.dark main [class*="border-emerald-100/"],
+.dark main [class*="border-emerald-200/"] {
+  border-color: color-mix(in srgb, var(--brand) 30%, var(--surface-raised)) !important;
+}
+.dark main [class*="border-amber-200/"] {
+  border-color: color-mix(in srgb, #f59e0b 30%, var(--surface-raised)) !important;
+}
