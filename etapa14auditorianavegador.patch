index 299fc27..a6f75e4 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -254,6 +254,28 @@ a:hover, button:hover {
 .dark main :is(div, section, article, aside, li, p, span, dl, dd, dt, table, thead, tbody, tr, th, td, nav, ul, ol, figure, label, a, button).bg-white {
