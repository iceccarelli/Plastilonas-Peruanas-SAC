+const MODOS = [
+  { n: 'movil-claro', w: 390, h: 900, m: true, osc: false },
+  { n: 'movil-oscuro', w: 390, h: 900, m: true, osc: true },
+  { n: 'escritorio-claro', w: 1440, h: 950, m: false, osc: false },
