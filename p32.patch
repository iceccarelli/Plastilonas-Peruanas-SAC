+};
+
+export default function CompradoresPage() {
+  return (
+    <div className="max-w-3xl mx-auto px-6 py-14">
+      <div className="uppercase tracking-[0.15em] text-xs text-[#059669] font-semibold mb-3">INTERNATIONAL BUYERS</div>
