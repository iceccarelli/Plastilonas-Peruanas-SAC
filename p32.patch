+            </ul>
+          </div>
+          <p className="mt-8 text-sm text-gray-500">
+            ¿Tiene un requerimiento concreto?{' '}
+            <Link href="/cotizacion" className="text-[#059669] font-medium">Pida una cotización</Link>{' '}
