+     * máquina. Subir el techo no esconde un bloqueo real —no hay nada que
+     * pueda quedarse esperando— y sí elimina el falso rojo.
+     */
+    testTimeout: 20_000,
+    hookTimeout: 20_000,
   },
   resolve: {
     alias: { '@': resolve(__dirname, '.') },
