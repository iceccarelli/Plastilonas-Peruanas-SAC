+    `Factor de seguridad pedido: ${s.sf} (a confirmar en cotización)`,
+    s.extras.length ? `Opciones: ${s.extras.join(", ")}` : "",
+    s.product ? `Producto a envasar: ${s.product}` : "",
+    s.quantity ? `Cantidad: ${s.quantity}` : "",
+    s.notes ? `Notas: ${s.notes}` : "",
+  ]
+    .filter(Boolean)
+    .join("\n");
+}
